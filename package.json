{
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start",
    "lint": "eslint .",
    "api-generate": "prisma generate",
    "api-push": "prisma db push && yarn seed",
    "api-migrate": "prisma db migrate",
    "typecheck": "next typegen && tsc --noEmit",
    "import-data": "node ./scripts/generate-objects.js",
    "seed": "yarn import-data && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcrypt": "6.0.0",
    "dotenv": "17.2.4",
    "next": "16.3.1",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcrypt": "6.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.26",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "packageManager": "yarn@4.18.0"
