{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "react",
    "jsx-a11y",
    "nextjs",
    "import",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off"
  },
  "ignorePatterns": [
    ".next/**",
    ".yarn/**",
    "lib/generated/**",
    "myning/**",
    "public/**"
  ]
}
